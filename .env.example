# --- Phase frontend (données simulées) ---
# Secret partagé pour déclencher les tâches planifiées via POST /api/v1/jobs/run
# (en-tête « Authorization: Bearer <CRON_SECRET> »). Générer avec : openssl rand -hex 32
CRON_SECRET=

# Mettre à 1 uniquement derrière un reverse proxy de confiance (lecture de X-Forwarded-For pour la limitation par IP)
TRUST_PROXY=0

# Appliquer les migrations de la base au démarrage du serveur (image Docker / Coolify). En développement : npm run db:migrate.
KOTI_AUTO_MIGRATE=0

# --- Version de démonstration publique (voir docs/DEPLOIEMENT_COOLIFY.md) ---
# Bandeau « Version de démonstration » + page /guide + comptes de démo affichés sur la connexion
KOTI_DEMO_MODE=0
# Bouton « Réinitialiser la démo » dans le profil (laisser à 0 si des testeurs partagent l'instance)
KOTI_ALLOW_DEMO_RESET=0

# --- Authentification (Better Auth) ---
# Secret de signature des sessions : openssl rand -hex 32 (obligatoire en production).
BETTER_AUTH_SECRET=
# Adresse publique de l'application (liens des e-mails) : obligatoire en production, https://… ; en développement : http://localhost:3700.
# BETTER_AUTH_URL=http://localhost:3700
# Autres origines autorisées, séparées par des virgules (facultatif).
# BETTER_AUTH_TRUSTED_ORIGINS=
# Courrier sortant. Sans SMTP_URL, les e-mails sont écrits dans les journaux du serveur (développement).
# En local : docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit  puis SMTP_URL=smtp://127.0.0.1:1025 (boîte de réception sur http://localhost:8025).
# SMTP_URL=smtp://utilisateur:motdepasse@hote:587
# MAIL_FROM="KOTI <no-reply@votredomaine>"
# Exiger la confirmation de l'adresse e-mail avant la première connexion (nécessite SMTP_URL).
KOTI_REQUIRE_EMAIL_VERIFICATION=0

# --- Production : premier administrateur et règlement des offres ---
# Création du premier Super administrateur au démarrage (seulement si aucun compte d'équipe n'existe ; mot de passe ≥ 12 caractères).
# KOTI_BOOTSTRAP_ADMIN_EMAIL=direction@votredomaine
# KOTI_BOOTSTRAP_ADMIN_PASSWORD=
# KOTI_BOOTSTRAP_ADMIN_NAME="Administrateur KOTI"
# 0 (défaut) : règlement manuel, l'équipe KOTI active l'offre après paiement ; 1 : paiement en ligne (non disponible).
# KOTI_ONLINE_PAYMENTS=0

# --- Notifications push (Web Push) ---
# Générer UNE fois la paire de clés : npm run push:keys. La clé publique est lue par le navigateur (profil → Notifications) ;
# la clé privée ne quitte jamais le serveur. Changer la paire désabonne tous les appareils.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@votredomaine

# --- Phase backend ---
# Base PostgreSQL de l'application (npm run db:create puis npm run db:migrate).
# Les caractères spéciaux du mot de passe s'encodent dans l'URL (@ → %40, ! → %21). Mettre ce fichier dans .env.local (jamais commité).
# DATABASE_URL=postgresql://utilisateur:mot_de_passe@127.0.0.1:5432/koti
# Base des tests d'intégration (le nom DOIT se terminer par _test) : npm run db:create && npm run db:migrate:test
# DATABASE_URL_TEST=postgresql://utilisateur:mot_de_passe@127.0.0.1:5432/koti_test
