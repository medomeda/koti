# --- Phase frontend (données simulées) ---
# Secret partagé pour déclencher les tâches planifiées via POST /api/v1/jobs/run
# (en-tête « Authorization: Bearer <CRON_SECRET> »). Générer avec : openssl rand -hex 32
CRON_SECRET=

# Mettre à 1 uniquement derrière un reverse proxy de confiance (lecture de X-Forwarded-For pour la limitation par IP)
TRUST_PROXY=0

# Appliquer les migrations de la base au démarrage du serveur (image Docker / Coolify). En développement : npm run db:migrate.
KOTI_AUTO_MIGRATE=0

# --- Version de démonstration publique (voir docs/DEPLOIEMENT_COOLIFY.md) ---
# Bandeau « Version de démonstration » + page /guide + comptes de démo affichés sur la connexion
KOTI_DEMO_MODE=0
# Bouton « Réinitialiser la démo » dans le profil (laisser à 0 si des testeurs partagent l'instance)
KOTI_ALLOW_DEMO_RESET=0

# --- Phase backend ---
# Base PostgreSQL de l'application (npm run db:create puis npm run db:migrate).
# Les caractères spéciaux du mot de passe s'encodent dans l'URL (@ → %40, ! → %21). Mettre ce fichier dans .env.local (jamais commité).
# DATABASE_URL=postgresql://utilisateur:mot_de_passe@127.0.0.1:5432/koti
# Base des tests d'intégration (le nom DOIT se terminer par _test) : npm run db:create && npm run db:migrate:test
# DATABASE_URL_TEST=postgresql://utilisateur:mot_de_passe@127.0.0.1:5432/koti_test
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3700
